@model Hotel.Web.Models.Reserva
@{ ViewData["Title"] = "Nueva reserva"; }
<section class="page-heading"><a asp-action="Index" class="back-link">← Reservas</a><span class="eyebrow">TU PRÓXIMA ESTANCIA</span><h1>Nueva reserva</h1><p>Elige a la persona huésped, la habitación y las fechas del viaje.</p></section>
<div class="form-layout reservation-layout">
    <div class="content-card form-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-panel"></div>
            <section class="form-section" aria-labelledby="guest-title"><div class="card-heading"><span class="step-number">01</span><div><h2 id="guest-title">Huésped y habitación</h2><p>Selecciona quién se hospedará y dónde.</p></div></div><div class="form-grid"><div class="field"><label asp-for="IdHuesped" class="form-label">Huésped</label><select asp-for="IdHuesped" asp-items="ViewBag.Huespedes" class="form-select"><option value="">Selecciona un huésped</option></select><span asp-validation-for="IdHuesped" class="field-error"></span></div><div class="field"><label asp-for="IdHabitacion" class="form-label">Habitación</label><select asp-for="IdHabitacion" asp-items="ViewBag.Habitaciones" class="form-select"><option value="">Selecciona una habitación</option></select><span asp-validation-for="IdHabitacion" class="field-error"></span></div></div></section>
            <section class="form-section" aria-labelledby="dates-title"><div class="card-heading"><span class="step-number">02</span><div><h2 id="dates-title">Fechas de la estancia</h2><p>La salida debe ser posterior al ingreso.</p></div></div><div class="form-grid"><div class="field"><label asp-for="FechaIngreso" class="form-label">Ingreso</label><input asp-for="FechaIngreso" type="date" class="form-control"/><span asp-validation-for="FechaIngreso" class="field-error"></span></div><div class="field"><label asp-for="FechaSalida" class="form-label">Salida</label><input asp-for="FechaSalida" type="date" class="form-control"/><span asp-validation-for="FechaSalida" class="field-error"></span></div></div></section>
            <section class="form-section" aria-labelledby="notes-title"><div class="card-heading"><span class="step-number">03</span><div><h2 id="notes-title">Un detalle más</h2><p>Cuéntanos algo útil sobre esta estancia, si lo deseas.</p></div></div><div class="field"><label asp-for="Observaciones" class="form-label">Observaciones <span class="optional">Opcional</span></label><textarea asp-for="Observaciones" class="form-control" maxlength="200" rows="4" placeholder="Ej. Llegada por la tarde"></textarea><span asp-validation-for="Observaciones" class="field-error"></span><small class="field-hint">Hasta 200 caracteres.</small></div></section>
            <div class="form-actions"><button class="btn btn-primary" type="submit">Guardar reserva <span aria-hidden="true">→</span></button><a asp-action="Index" class="btn btn-quiet">Volver</a></div>
        </form>
    </div>
    <aside class="booking-note"><span class="note-spark" aria-hidden="true">✦</span><h3>Tu viaje, bien organizado</h3><p>La reserva se creará con estado <strong>Pendiente</strong>. Podrás verla y gestionarla desde la lista de reservas.</p><div class="note-line"></div><a asp-action="Disponibles" class="note-link">¿Aún no sabes qué habitación elegir? Consulta disponibilidad <span aria-hidden="true">→</span></a></aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
