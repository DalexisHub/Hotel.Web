@model Hotel.Web.Models.Habitacion
@{ ViewData["Title"] = "Detalle de habitación"; }
<section class="page-heading"><a asp-action="Index" class="back-link">← Habitaciones</a><span class="eyebrow">DETALLE DEL ESPACIO</span><h1>Habitación @Model.Numero</h1><p>Un vistazo a sus características y tarifa.</p></section>
<div class="detail-layout"><div class="detail-art" aria-hidden="true"><span class="detail-sun"></span><span class="detail-window"></span><span class="detail-label">HABITACIÓN @Model.Numero</span></div><div class="content-card detail-card"><span class="type-pill">@Model.IdTipoHabitacionNavigation.Nombre</span><h2>Tu espacio de descanso</h2><div class="detail-facts"><div><span>Piso</span><strong>@Model.Piso</strong></div><div><span>Capacidad</span><strong>@Model.IdTipoHabitacionNavigation.Capacidad persona(s)</strong></div><div><span>Estado</span><strong>@(Model.Activo ? "Activa" : "Inactiva")</strong></div></div><div class="detail-price"><span>Precio por noche</span><strong>@Model.IdTipoHabitacionNavigation.PrecioNoche.ToString("C")</strong></div><div class="form-actions"><a asp-action="Edit" asp-route-id="@Model.IdHabitacion" class="btn btn-primary">Editar habitación</a><a asp-action="Index" class="btn btn-quiet">Volver</a></div></div></div>
